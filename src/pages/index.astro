---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site.config';
import ReviveSlot from '../components/ads/ReviveSlot.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft && (!data.lang || data.lang === 'fr'));
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = posts.slice(0, 6);
---

<Layout title={siteConfig.name}>
  <!-- Hero Section -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 border-b bg-white">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4">
        {siteConfig.name}
      </h1>
      <p class="text-lg sm:text-xl text-stone-600 max-w-2xl mx-auto leading-relaxed mb-6">
        {siteConfig.description}
      </p>
      <div class="flex justify-center gap-3">
        <a href="/blog" class="px-5 py-2.5 rounded-lg bg-black text-white font-medium text-sm hover:opacity-90 transition-opacity">
          Consulter les articles &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Derniers Articles -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-center justify-between border-b pb-4 mb-8">
      <h2 class="text-2xl font-bold tracking-tight">Dernières publications</h2>
      <a href="/blog" class="text-sm font-semibold hover:underline">Voir tout &rarr;</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {recentPosts.map(post => (
        <article class="bg-white rounded-xl border p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col">
          {post.data.heroImage && (
            <a href={`/blog/${post.id}`} class="aspect-[4/5] overflow-hidden rounded-lg mb-4 bg-stone-100">
              <img src={post.data.heroImage} alt={post.data.title} class="w-full h-full object-cover" loading="lazy" />
            </a>
          )}
          <span class="text-xs font-semibold uppercase text-stone-500 mb-2">{post.data.category}</span>
          <h3 class="text-base font-bold text-stone-900 hover:text-blue-600 transition-colors line-clamp-2 mb-2">
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
          </h3>
          <p class="text-xs text-stone-600 line-clamp-3 mb-4 flex-grow">{post.data.description}</p>
          <div class="text-[11px] text-stone-400 pt-3 border-t">
            {new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}
          </div>
        </article>
      ))}
    </div>

    {siteConfig.revive?.zones?.inContent && (
      <div class="my-10 flex justify-center">
        <ReviveSlot format={siteConfig.revive.zones.inContent.format} zoneId={siteConfig.revive.zones.inContent.zoneId} />
      </div>
    )}
  </div>
</Layout>
