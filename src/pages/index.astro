---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site.config';
import ReviveSlot from '../components/ads/ReviveSlot.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft && (!data.lang || data.lang === 'fr'));
allPosts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
const featuredPosts = allPosts.slice(0, 9);

const accommodationCollections = [
  { title: "Villas de Prestige Vue Mer", code: "VILLA-PRESTIGE-01", desc: "Propriétés haut de gamme avec piscine à débordement, varangues ventilées, conciergerie privée et vue panoramique sur l'océan.", icon: "🏰", link: "/blog/" },
  { title: "Bungalows & Écolodges en Forêt", code: "ECO-BUNGALOW-02", desc: "Hébergements en bois exotique nichés au cœur de la forêt tropicale de Basse-Terre, bassins naturels et calme absolu.", icon: "🌿", link: "/blog/" },
  { title: "Maisons de Charme Pieds dans l'Eau", code: "BEACH-FRONT-03", desc: "Villas familiales et gîtes disposant d'un accès direct au sable blanc des lagons de Sainte-Anne et du Gosier.", icon: "🏖️", link: "/blog/" },
  { title: "Domaines Ruraux & Hauts de Basse-Terre", code: "RURAL-ESTATE-04", desc: "Anciennes caféières rénovées, fraîcheur des hauteurs de Saint-Claude et vue imprenable sur le volcan de La Soufrière.", icon: "☕", link: "/blog/" },
  { title: "Appartements & Résidences de Marina", code: "MARINA-SUITE-05", desc: "Locations tout confort au cœur de la marina de Saint-François, à proximité immédiate des restaurants et du golf 18 trous.", icon: "⛵", link: "/blog/" },
  { title: "Escapades aux Saintes & Marie-Galante", code: "ISLAND-STAY-06", desc: "Boutique-hôtels intimes et cases traditionnelles pour une immersion paisible dans les dépendances de l'archipel.", icon: "🌺", link: "/blog/" },
];
---

<Layout title="Hébergement Guadeloupe — Villas avec Piscine, Gîtes & Locations de Vacances">
  <!-- Hero Section Lexington Mulberry Style -->
  <section class="relative overflow-hidden pt-12 pb-16 lg:py-24 border-b border-[#e7e1d8] bg-[#faf8f5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-[#f0eae1] border border-[#e2d7c7] text-[#73583c] text-xs font-mono font-medium tracking-wide uppercase mb-6">
          <span class="w-2 h-2 rounded-full bg-[#a3794b]"></span>
          <span>Séjours de Charme • Villas avec Piscine • Réservation Directe</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-serif font-black text-[#2b2723] tracking-tight leading-[1.08] mb-6">
          L'ART DE SÉJOURNER EN GUADELOUPE, <span class="italic underline decoration-[#a3794b] decoration-wavy underline-offset-8">ENTRE CONFORT & NATURE</span>.
        </h1>

        <p class="text-lg sm:text-xl text-[#665e55] leading-relaxed font-normal mb-8">
          Le répertoire indépendant des plus belles adresses de villégiature de l'archipel : villas contemporaines d'exception, gîtes créoles authentiques et conseils avisés pour réserver en direct sans intermédiaires.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a href="/blog/" class="px-6 py-3.5 rounded-lg bg-[#2b2723] text-white font-medium text-sm hover:bg-[#403a35] transition-colors shadow-sm">
            Explorer les 200 Guides &rarr;
          </a>
          <a href="#collections" class="px-6 py-3.5 rounded-lg border border-[#d6cbbe] text-[#524941] font-medium text-sm hover:bg-[#f0eae1] transition-colors">
            Voir les Catégories
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- International Editions Hub (i18n) -->
  <section class="border-b border-[#e7e1d8] bg-[#f5f1ea] py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/en/" class="group p-5 rounded-xl bg-white border border-[#e7e1d8] hover:border-[#a3794b] transition-all flex items-center justify-between shadow-xs">
          <div>
            <div class="flex items-center space-x-2 mb-1">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#a3794b]">English Edition</span>
              <span class="text-[10px] bg-[#f5f1ea] text-[#665e55] px-2 py-0.5 rounded border border-[#e7e1d8]">EN</span>
            </div>
            <h3 class="text-base font-serif font-bold text-[#2b2723] group-hover:text-[#a3794b] transition-colors">
              Guadeloupe Luxury Villa Rentals & Accommodations Guide
            </h3>
            <p class="text-xs text-[#736a61] mt-1">
              Premier private pools, direct beach access, eco-lodges, and direct booking advice.
            </p>
          </div>
          <span class="text-xl text-[#a3794b] group-hover:translate-x-1 transition-transform ml-4">&rarr;</span>
        </a>

        <a href="/es/" class="group p-5 rounded-xl bg-white border border-[#e7e1d8] hover:border-[#a3794b] transition-all flex items-center justify-between shadow-xs">
          <div>
            <div class="flex items-center space-x-2 mb-1">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#a3794b]">Edición en Español</span>
              <span class="text-[10px] bg-[#f5f1ea] text-[#665e55] px-2 py-0.5 rounded border border-[#e7e1d8]">ES</span>
            </div>
            <h3 class="text-base font-serif font-bold text-[#2b2723] group-hover:text-[#a3794b] transition-colors">
              Alquiler de Villas de Lujo y Casas Vacacionales en Guadalupe
            </h3>
            <p class="text-xs text-[#736a61] mt-1">
              Selección exclusiva de alojamientos con piscina privada, vistas al mar y cabañas ecológicas.
            </p>
          </div>
          <span class="text-xl text-[#a3794b] group-hover:translate-x-1 transition-transform ml-4">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Collections Thématiques (Mulberry Grid) -->
  <section id="collections" class="py-16 border-b border-[#e7e1d8] bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-[#a3794b] font-bold block mb-2">Sélection Exclusivité</span>
          <h2 class="text-2xl sm:text-4xl font-serif font-black text-[#2b2723] tracking-tight">
            6 Catégories d'Hébergements de Charme
          </h2>
        </div>
        <p class="text-sm text-[#736a61] max-w-md mt-4 md:mt-0 font-serif">
          Chaque style d'hébergement rigoureusement décrit pour vous orienter vers la villégiature idéale selon vos exigences de confort.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {accommodationCollections.map(item => (
          <div class="p-6 rounded-xl border border-[#e7e1d8] bg-[#faf8f5] hover:bg-white hover:border-[#a3794b] transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-2xl">{item.icon}</span>
                <span class="text-[11px] font-mono font-medium text-[#736a61] bg-white px-2 py-0.5 rounded border border-[#e7e1d8]">{item.code}</span>
              </div>
              <h3 class="text-lg font-serif font-bold text-[#2b2723] mb-2">{item.title}</h3>
              <p class="text-xs text-[#665e55] leading-relaxed">{item.desc}</p>
            </div>
            <div class="mt-6 pt-4 border-t border-[#e7e1d8] flex items-center justify-between text-xs font-semibold text-[#a3794b]">
              <a href={item.link} class="hover:underline">Découvrir les fiches &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Derniers Articles & Guides Pratiques -->
  <section class="py-16 bg-[#faf8f5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8 border-b border-[#e7e1d8] pb-4">
        <div>
          <h2 class="text-2xl font-serif font-black text-[#2b2723] tracking-tight">Dossiers & Conseils de Réservation</h2>
          <p class="text-xs text-[#736a61] mt-1">Les dernières analyses et sélections de biens publiées par nos experts.</p>
        </div>
        <a href="/blog/" class="text-xs font-bold text-[#a3794b] hover:text-[#73583c] transition-colors uppercase tracking-wider">
          Tous les dossiers ({allPosts.length}) &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredPosts.map(post => (
          <article class="p-5 rounded-xl bg-white border border-[#e7e1d8] shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <span class="text-[11px] font-mono font-semibold uppercase text-[#a3794b] block mb-2">{post.data.category || 'Hébergement'}</span>
              <h3 class="text-base font-serif font-bold text-[#2b2723] hover:text-[#a3794b] transition-colors line-clamp-2 mb-2">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h3>
              <p class="text-xs text-[#665e55] line-clamp-3 leading-relaxed mb-4">{post.data.description}</p>
            </div>
            <div class="pt-3 border-t border-[#f0eae1] flex items-center justify-between text-[11px] text-[#8c8278]">
              <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
              <a href={`/blog/${post.id}/`} class="text-[#a3794b] font-semibold hover:underline">Lire le dossier &rarr;</a>
            </div>
          </article>
        ))}
      </div>

      <!-- Revive In-Content Slot -->
      {siteConfig.revive?.zones?.inContent && (
        <div class="my-10 flex justify-center">
          <ReviveSlot format={siteConfig.revive.zones.inContent.format} zoneId={siteConfig.revive.zones.inContent.zoneId} />
        </div>
      )}
    </div>
  </section>
</Layout>
